{
  "name": "Waystile",
  "description": "Open links and the current page in any browser or profile with Waystile.",
  "version": "0.4.1",
  "manifest_version": 2,
  "homepage_url": "https://github.com/kevincorvallis/waystile",
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "contentScript.js"
      ]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png",
    "256": "icon256.png"
  },
  "permissions": [
    "contextMenus",
    "<all_urls>",
    "activeTab"
  ],
  "browser_action": {
    "default_title": "Choose browser or profile",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png",
      "256": "icon256.png"
    }
  },
  "commands": {
    "choose-profile": {
      "description": "Open this page in another browser or profile",
      "suggested_key": {
        "default": "Alt+Shift+O"
      }
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "finicky-profiles@kevinlee.github.io"
    }
  }
}
